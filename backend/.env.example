# Server
PORT=5001

# MongoDB — replace with your connection string
MONGODB_URI=mongodb://localhost:27017/lydstrust-bank

# JWT — must be a long, cryptographically random string (e.g. run: openssl rand -hex 64)
JWT_SECRET=your_jwt_secret_here

# NibssByPhoenix API — get these by registering with your email and bank name
# Registration endpoint: POST https://nibssbyphoenix.onrender.com/api/onboard
# Swagger docs: https://nibssbyphoenix.onrender.com/api/docs/#/
NIBSS_API_KEY=your_nibss_api_key
NIBSS_API_SECRET=your_nibss_api_secret
NIBSS_BASE_URL=https://nibssbyphoenix.onrender.com

# Your bank identity on NIBSS
BANK_CODE=your_bank_code
BANK_NAME=Your Bank Name

# Gmail SMTP — for transaction alert emails
# Use an App Password (not your regular password): myaccount.google.com/apppasswords
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# Optional — your deployed frontend URL, added to CORS allowlist (e.g. https://yourdomain.com)
CLIENT_URL=
